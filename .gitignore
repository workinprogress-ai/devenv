repos/
repos/*
.debug/
.debug/*
.setup/
.setup/*
node_modules/
.pnpm-store/
.cache/
# User-level custom scripts (ignored - personal customizations)
.devcontainer/user-custom-startup.sh
.devcontainer/user-custom-bootstrap.sh
.devcontainer/user-custom-scripts

dotnet-install.*

# Runtime-generated files
.runtime/
.runtime/*
temp/
temp/*
tmp/
tmp/*
mnt/
mnt/*
playground/
playground/*
.installs/
.installs/*
*.log

# Copilot knowledge is synced from an external repo during bootstrap/update
copilot/knowledge/
copilot/knowledge/*

# Engineering standards are synced from an external repo during bootstrap/update
copilot/engineering/
copilot/engineering/*

# Ignore symlinks in tools/ but keep subdirectories
tools/*
tools/custom/
!tools/lib/
!tools/scripts/
!tools/other/
!tools/tests/
!tools/config
!tools/templates
!tools/git-hooks/
!tools/special/

# Ignore locally produced temporary artifacts
.prompts/
.local-artifacts/
.local-artifacts/*
# TAP output from bats --reporter tap runs at the repo root (test residue,
# never a source artifact)
report.tap

# Ignore garbage files that MacOS and other systems might produce
.DS_Store
Thumbs.db
Desktop.ini

# Local Azure DevOps PAT — 0600 secret file, never committed (auth.bash
# (the azure provider resolves its PAT from ~/.keys/azure-devops-pat —
#  outside every repo tree by design)
