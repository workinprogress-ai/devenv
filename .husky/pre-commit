# >>> devenv wip-gate >>>
# devenv WIP gate — enforces: only a WIP commit may follow a WIP commit.
# Run 'git-unwip' to clear WIP state before real commits.
# Self-locate the gate in THIS checkout first (an exported DEVENV_TOOLS may
# point at a foreign devenv checkout); fall back to the configured tools dir.
hook_repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$hook_repo_root" ] && [ -f "$hook_repo_root/tools/git-hooks/wip-gate.sh" ]; then
    bash "$hook_repo_root/tools/git-hooks/wip-gate.sh"
elif [ -n "${DEVENV_TOOLS:-}" ] && [ -f "$DEVENV_TOOLS/git-hooks/wip-gate.sh" ] \
     && [ "${DEVENV_TOOLS}" = "$hook_repo_root/tools" ]; then
    bash "$DEVENV_TOOLS/git-hooks/wip-gate.sh"
elif tools_dir=$(git config --global devenv.toolsDir 2>/dev/null) && [ -f "$tools_dir/git-hooks/wip-gate.sh" ]; then
    bash "$tools_dir/git-hooks/wip-gate.sh"
fi
# <<< devenv wip-gate <<<
#!/bin/sh

# Ensure we run from the devenv repository root
DEVENV_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$DEVENV_ROOT"

# Lint staged markdown files (if any)
if git diff --cached --name-only --diff-filter=ACM -z -- '*.md' | grep -qz .; then
    echo "Linting staged markdown files..."
    # Always invoke the devenv version of lint-documentation from the devenv root
    # Pass files directly via pipe to avoid variable expansion issues with null delimiters
    git diff --cached --name-only --diff-filter=ACM -z -- '*.md' | xargs -0 node "$DEVENV_ROOT/tools/ts/lint-documentation.ts"
fi
# A staged change to the lint or type configuration (or the dependency
# manifest) can break the type and lint gates without touching tools/; the full
# block below covers a commit that also stages tools/ or .devcontainer/.
if git diff --cached --name-only | grep -qE '^(eslint\.config\.js|tsconfig\.json|package\.json)$' \
   && ! git diff --cached --name-only | grep -qE '^(tools/|\.devcontainer/)'; then
    echo "Lint or type configuration changed - running typecheck and ESLint..."
    if ! (cd "$DEVENV_ROOT" && npx --no-install tsc --noEmit); then
        echo "Typecheck failed. Commit aborted."
        exit 1
    fi
    if ! (cd "$DEVENV_ROOT" && npx --no-install eslint tools); then
        echo "ESLint failed. Commit aborted."
        exit 1
    fi
fi
# Check if there are any staged changes in tools/ or .devcontainer/
if git diff --cached --name-only | grep -qE '^(tools/|\.devcontainer/)'; then
    echo "Changes detected in tools/ or .devcontainer/ - running tests and linting..."
    
    # Type and lint gates for the TypeScript tools
    if ! (cd "$DEVENV_ROOT" && npx --no-install tsc --noEmit); then
        echo "Typecheck failed. Commit aborted."
        exit 1
    fi
    if ! (cd "$DEVENV_ROOT" && npx --no-install eslint tools); then
        echo "ESLint failed. Commit aborted."
        exit 1
    fi

    # Run linting
    if ! node "$DEVENV_ROOT/tools/ts/lint-scripts.ts"; then
        echo "Linting failed. Commit aborted."
        exit 1
    fi
    
    # Run tests
    if ! "$DEVENV_ROOT/tools/tests/run-devenv-tests.sh"; then
        echo "Tests failed. Commit aborted."
        exit 1
    fi
    
    echo "All checks passed!"
fi

# Skill-tree contract check: run lint-skills when copilot/skills changes
if git diff --cached --name-only | grep -q '^copilot/skills/'; then
    echo "Skill tree changed - running lint-skills..."
    if ! node "$DEVENV_ROOT/tools/ts/lint-skills.ts"; then
        echo "lint-skills failed. Commit aborted."
        exit 1
    fi
fi
