# devenv Configuration File
# This file customizes devenv behavior for your organization
# Format: INI-style with [section] headers and key=value pairs
# Template variables supported: ${PROVIDER_ORG}, ${PROVIDER_USER} (expanded
# from the provider identity accessors at runtime; tokens are never
# interpolated — secrets resolve via the provider credential store)

[organization]
# Organization name (for display and project naming)
name=Work In Progress
# Organization owning the workspace's repos (provider-neutral; forks on
# other backends set this to their project/namespace).
org=workinprogress-ai
# GitHub-branded keys (github_org/github_user) are NOT read — identity
# resolves from the neutral keys and the .setup/ seeds only.
# Email domain for user validation (empty to accept any valid email)
email_domain=workinprogress.ai

[nuget]
# GitHub Packages feed URL with organization variable
# The ${PROVIDER_ORG} variable will be expanded at runtime
feed_url=https://nuget.pkg.github.com/${PROVIDER_ORG}/index.json

[workflows]
# Kanban workflow states (comma-separated, ordered by progression)
# Note: Hyphenated single tokens only - the parser splits on commas and whitespace
status_workflow=TBD,To-Groom,Ready,Implementing,Review,Merged,Staging,Production
# Staleness thresholds (days) for project-manager Assess/Recommend passes.
# Sane defaults; tune per org. Read via config-read, never hard-coded.
stale_to_groom_days=14
stale_ready_days=21
stale_implementing_days=30
stale_tbd_days=7

[copilot]
# Repository containing shared Copilot knowledge assets.
knowledge_repo=https://github.com/workinprogress-ai/docs.copilot-knowledge.git
# Subfolder inside knowledge_repo that should be linked to ~/.copilot/knowledge.
knowledge_subpath=copilot-knowledge/
# Repository containing engineering standards, patterns, and best practices.
# Canonical copy for skills: cloned/pulled into copilot/engineering during bootstrap
# and linked to ~/.copilot/engineering. Modifications happen in the repos/<name>
# clone via branches/PRs — never in copilot/engineering directly.
engineering_repo=https://github.com/workinprogress-ai/docs.engineering.git
# Subfolder inside engineering_repo that should be linked to ~/.copilot/engineering.
engineering_subpath=docs/
# name of the sibling clone under repos/ used for modifications.
engineering_repo_name=docs.engineering
# Read via `config-read copilot engineering_repo` (sibling clone under repos/).
# Forks may point this at their own standards repo without editing skills.
# Note: engineering_repo must stay the full clone URL — bootstrap passes it
# straight to git clone. The short name lives in engineering_repo_name.

[provider]
# Active provider backend for the tools layer
# All provider_* facade calls dispatch to modules under tools/lib/providers/<name>/.
# Forks adapting to a non-GitHub backend (e.g. Azure DevOps) change this key.
name=github
