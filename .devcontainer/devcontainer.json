// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "Dev Environment",

	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	// Pinned by digest (the multi-arch index for the bookworm tag), so every
	// build starts from the same image. To pick up base-image updates, resolve the
	// tag again and replace the digest in one reviewed change:
	//   curl -sI -H 'Accept: application/vnd.oci.image.index.v1+json' \
	//     https://mcr.microsoft.com/v2/devcontainers/base/manifests/bookworm
	// and read the Docker-Content-Digest header.
	"image": "mcr.microsoft.com/devcontainers/base:bookworm@sha256:3aacff4130e6cf04709f9cab1d7a6d3e1cc4bff6202bc61611831a18d3755673",
    "remoteEnv": {
        //"NODE_TLS_REJECT_UNAUTHORIZED": "0",
		"DEVCONTAINER": "true"
		//"SSH_AUTH_SOCK": "/ssh-agent"
    },

	// "mounts": [
	// 	"source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
	// ],

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// Only the desktop's noVNC web port (6090) is forwarded: that is how the desktop
	// is reached, in a browser (docs/Dev-container-environment.md). The raw VNC port
	// (5091, below) is deliberately not forwarded.
	"forwardPorts": [6090],
	"portsAttributes": {
			"6090": {
				"protocol": "http",
				"label": "Desktop Environment"
			}
	},

    "runArgs": [
                // PID ceiling for the container: the default (2048) is thin for a
                // container hosting a desktop session + docker-in-docker + VS Code
                // server + concurrent test-runner worker pools (cgroup v2 counts
                // every thread); 4096 leaves headroom for a full vitest lane at peak.
                "--pids-limit=4096"
                // "--cap-add=NET_ADMIN",
                // "--cap-add=SYS_ADMIN",
                // "--device=/dev/net/tun"
        ],

    "remoteUser": "vscode",
	"postStartCommand": "/bin/bash .devcontainer/container-start.sh",

    // Docker extra run args
    // "runArgs": [
    //     "-v",
    //     "${env:SSH_AUTH_SOCK}:/tmp/ssh-agent.socket",
    //     "-e",
    //     "SSH_AUTH_SOCK=/tmp/ssh-agent.socket"
    // ],

    // Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
        "ghcr.io/devcontainers/features/desktop-lite": {
            "webPort": 6090,
            "vncPort": 5091,
            "password": "vscode"
		},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/node:1": {
			// The image must guarantee Node >= the TS tooling floor
			// (tools/lib/core/node-floor.ts) at a known location: the thin
			// bootstrap resolves the feature's nvm dir onto PATH and hands off
			// to the TS setup orchestrator. NODE_VERSION in tool-versions.bash
			// must stay equal to this pin.
			"version": "24.18.0"
		},
        "ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// Configure tool-specific properties.
	"customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.vscode-dotnet-runtime",
				"ms-dotnettools.csdevkit",
				"ms-vsliveshare.vsliveshare",
				"ms-vscode-remote.remote-ssh",
				"ms-azuretools.vscode-docker",
				
				"rafistatar.addlocalnetreferences",
				"rogalmic.bash-debug",
				"alefragnani.bookmarks",
				"k--kato.docomment",
				"streetsidesoftware.code-spell-checker",
				"ms-vscode-remote.remote-containers",
				"eamodio.gitlens",
				"tintoy.msbuild-project-tools",
				"quicktype.quicktype",
				"christian-kohler.path-intellisense",
				"dinhani.divider",
				"wayou.vscode-todo-highlight",
				"fullstackspider.visual-nuget",
				"ms-mssql.mssql",
				"cweijan.vscode-redis-client",
				"mongodb.mongodb-vscode",
				"EditorConfig.EditorConfig",
				"humao.rest-client",
                "dotjoshjohnson.xml",
                "rangav.vscode-thunder-client",
                "simonsiefke.svg-preview",
                "uctakeoff.vscode-counter",
                "pflannery.vscode-versionlens",
                "antmdvs.vscode-react-hooks-snippets",
                "yoavbls.pretty-ts-errors",
                "rvest.vs-code-prettier-eslint",
                "esbenp.prettier-vscode",
                "devine-davies.make-hidden",
                "donjayamanne.githistory",
                "dbaeumer.vscode-eslint",
                "gurayyarar.dummytextgenerator",
				"davidanson.vscode-markdownlint",
				
				"github.copilot",
				"github.copilot-chat",
				"github.vscode-pull-request-github",
				"github.remotehub",
				"github.vscode-github-actions"
			],
            "settings": {
                "github.copilot.chat.additionalReadAccessPaths": [
                    "${containerWorkspaceFolder}",
                    "${containerWorkspaceFolder}/tmp",
                    "${containerWorkspaceFolder}/copilot",
                    "${containerWorkspaceFolder}/copilot/knowledge",
                    "${containerWorkspaceFolder}/copilot/skills",
                    "${containerWorkspaceFolder}/devenv.config",
                    "${containerWorkspaceFolder}/repos",
                    "${containerWorkspaceFolder}/copilot/knowledge",
                    "${containerWorkspaceFolder}/playground",
                    "${containerWorkspaceFolder}/.github",
                    "${containerWorkspaceFolder}/tools",
                    "${containerWorkspaceFolder}/docs",
                    "/home/vscode",
                    "/tmp"
                ],
                "chat.tools.edits.autoApprove": {
                    "/tmp/**": true,
                    "${containerWorkspaceFolder}/playground/**": true,
                    "${containerWorkspaceFolder}/tmp/**": true,
                    "${containerWorkspaceFolder}/.debug/**": true
                },
                "chat.tools.terminal.autoApprove": {
                    "/^git (diff|show|log|diff-tree|diff-index)( (--|--stat|--name-only|--name-status|--oneline|--graph|--no-color|--patch|-p|--shortstat|--numstat|--summary|--cached|--staged|-r|--no-commit-id|--root|--decorate|--abbrev-commit|-[0-9]+|-U[0-9]+|-n|--max-count=[0-9]+|--unified=[0-9]+|(?!(?:[^ /]*/)*\\.\\.(?:/| |$))[A-Za-z0-9_./^~@{}:][A-Za-z0-9_./^~@{}:-]*))*$/": true,
                    "artifacts-list": true,
                    "cat": true,
                    "ci-build-local": true,
                    "command -v": true,
                    "command-tier": true,
                    "config-read": true,
                    "cs-dependencies-trace": true,
                    "cs-extract-snupkgs": true,
                    "cs-open-coverage": true,
                    "cut": true,
                    "date": true,
                    "devenv-marker-check": true,
                    "devenv-memory-watch": true,
                    "diff": true,
                    "docker images": true,
                    "docker ps": true,
                    "docker version": true,
                    "dotnet --info": true,
                    "dotnet --version": true,
                    "dotnet list package": true,
                    "file": true,
                    "fork-export": true,
                    "get-public-ip": true,
                    "git cat-file": true,
                    "git describe": true,
                    "git for-each-ref": true,
                    "git ls-files": true,
                    "git merge-base": true,
                    "git name-rev": true,
                    "git rev-list": true,
                    "git rev-parse": true,
                    "git shortlog": true,
                    "git status": true,
                    "git-graph": true,
                    "git-graph-all": true,
                    "grep": true,
                    "head": true,
                    "id": true,
                    "issue-artifact-doc-id": true,
                    "issue-artifact-get": true,
                    "issue-artifact-list": true,
                    "issue-artifact-select": true,
                    "issue-comment-list": true,
                    "issue-get": true,
                    "issue-label-list": true,
                    "issue-list": true,
                    "issue-search": true,
                    "issue-select": true,
                    "issue-types": true,
                    "jq": true,
                    "kube-deployment-select": true,
                    "kube-describe": true,
                    "kube-events": true,
                    "kube-list-pods": true,
                    "kube-logs": true,
                    "kube-pod-select": true,
                    "kube-rollout": true,
                    "kube-set-context": true,
                    "kube-top": true,
                    "lint-documentation": true,
                    "lint-scripts": true,
                    "lint-skills": true,
                    "ls": true,
                    "lsof": true,
                    "metrics-count-code-lines": true,
                    "mongo-backup-server": true,
                    "next-id": true,
                    "node --version": true,
                    "pipelines-artifacts": true,
                    "pipelines-list": true,
                    "pipelines-status": true,
                    "pipelines-watch": true,
                    "plan-parse": true,
                    "pnpm list": true,
                    "pnpm outdated": true,
                    "policy-export": true,
                    "pr-diff": true,
                    "pr-get": true,
                    "pr-get-merge-link": true,
                    "pr-get-review-link": true,
                    "pr-list": true,
                    "pr-threads-get": true,
                    "project-list-for-issue": true,
                    "provider-explain": true,
                    "release-list": true,
                    "repo-batch-draft": true,
                    "repo-calc-version": true,
                    "repo-get-web-url": true,
                    "repo-version-list": true,
                    "rg": true,
                    "roadmap-parse": true,
                    "run-devenv-tests": true,
                    "skill-orient": true,
                    "spec-dependency-check": true,
                    "ss": true,
                    "stat": true,
                    "tail": true,
                    "terraform-plan": true,
                    "tree": true,
                    "uname": true,
                    "uniq": true,
                    "wc": true,
                    "which": true,
                    "whoami": true,
                    "yq": true
                }
            }
        }
    }
}
