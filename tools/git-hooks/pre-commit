#!/bin/bash
# pre-commit: block normal commits when WIP commits are present
#
# Thin caller: the gate logic lives in wip-gate.sh (same directory) so that
# husky-based repos can run the identical check via their delegation blocks.
# This hook only fires where the effective core.hooksPath resolves here —
# i.e. repos with no local core.hooksPath override.

set -uo pipefail
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"

exec bash "$HOOK_DIR/wip-gate.sh"
