#!/usr/bin/env bash
# run-smoke-tests — run the Azure provider smoke tests from this folder.
#
# Two lanes:
#   (default)  the offline vitest suite (azure-smoke-harness.test.ts): the
#              harness driven against fake curl/git-push — no network, ~minutes.
#   --live     the live validation harness (azure-smoke-test.sh) against a real
#              Azure DevOps org. Requires AZURE_PAT + AZURE_DEVOPS_ORG + a
#              configured project; AZURE_SMOKE=1 for the read-only tier,
#              AZURE_SMOKE=write adds the destructive tier (creates and deletes
#              fixtures). Confirm with AZURE_SMOKE_CONFIRM=y.
#
# Excluded from the default run-devenv-tests suite because the vitest lane
# takes many minutes (49 harness invocations); run it here or via:
#   pnpm exec vitest run tools/tests/ts/azure-smoke-harness.test.ts
#
# Usage:
#   ./run-smoke-tests              # offline vitest suite (no network)
#   ./run-smoke-tests --live       # live harness, read-only tier
#   AZURE_SMOKE=write ./run-smoke-tests --live   # live harness, destructive tier
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-}" in
    ""|--offline)
        ROOT="$(cd "$HERE/../../../.." && pwd)"   # the devenv checkout root (azure -> providers -> lib -> tools -> root)
        TEST="$ROOT/tools/tests/ts/azure-smoke-harness.test.ts"
        # pnpm exec resolves the vitest binary from the checkout root's
        # node_modules, so cd there regardless of the caller's cwd.
        cd "$ROOT"
        exec pnpm exec vitest run "$TEST" \
            --config "$ROOT/tools/lib/providers/azure/vitest.smoke.config.ts" \
            --root "$ROOT"
        ;;
    --live)
        if [ "${AZURE_SMOKE:-}" = "write" ] && [ "${AZURE_SMOKE_CONFIRM:-}" != "y" ]; then
            echo "DESTRUCTIVE tier requested (AZURE_SMOKE=write): re-run with AZURE_SMOKE_CONFIRM=y to proceed" >&2
            exit 1
        fi
        exec bash "$HERE/azure-smoke-test.sh"
        ;;
    *)
        echo "Usage: $0 [--offline | --live]" >&2
        echo "  (default)/--offline  offline vitest suite (fake curl/git-push, no network)" >&2
        echo "  --live               live azure-smoke-test.sh against a real org" >&2
        exit 1
        ;;
esac
