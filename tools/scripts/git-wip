#!/bin/bash
# git-wip: stage everything and push a WIP snapshot commit.
#
# Hook-bypass exception (intentional): this commit is created with `git
# commit -n`, bypassing pre-commit/commit-msg hooks. WIP snapshots are
# throwaway checkpoints by design — requiring them to pass commitlint would
# defeat their purpose. The exception covers WIP snapshots here and the forced
# version-bump empty commits in repo-bump-version.sh; normal commits must
# always go through hooks.
#
# Message input: positional args (joined with spaces) or --file <path> for a
# pre-written message (long messages arrive unmangled; the file content is
# used verbatim after the WIP: prefix). --file and positional args are
# mutually exclusive.
#
# Failure is loud: a failed commit or push exits non-zero, and refs/wip/last
# moves only after the push succeeded (the commit skill trusts this tool's own
# success output).

set -euo pipefail

STAGED_ONLY=false
MSG_FILE=""

print_usage() {
    cat <<'EOF'
Usage: git-wip [--staged-only] [--file <path>] ["<message words...>"]

Stage everything (or --staged-only to skip staging) and push a WIP snapshot
commit prefixed with "WIP: ".

  --staged-only   Do not run `git add -A`; commit the existing index.
  --file <path>   Read the message from a file (used verbatim after the
                  WIP: prefix). Mutually exclusive with positional words.
EOF
}

ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --staged-only)
      STAGED_ONLY=true
      ;;
    --file)
      [ -n "${2:-}" ] || { echo "Error: --file requires a path" >&2; exit 1; }
      MSG_FILE="$2"
      shift   # consume the path too (the loop's trailing shift consumes --file)
      ;;
    -h|--help)
      print_usage
      exit 0
      ;;
    --*)
      echo "Error: unknown flag '$1'" >&2
      exit 1
      ;;
    *)
      ARGS+=("$1")
      ;;
  esac
  shift
done

if [ -n "$MSG_FILE" ] && [ ${#ARGS[@]} -gt 0 ]; then
  echo "Error: --file and a positional message are mutually exclusive" >&2
  exit 1
fi

if [ -n "$MSG_FILE" ]; then
  if [ ! -f "$MSG_FILE" ]; then
    echo "Error: message file not found: $MSG_FILE" >&2
    exit 1
  fi
  MSG="$(cat "$MSG_FILE")"
else
  MSG="${ARGS[*]:-}"
fi

if [ "$STAGED_ONLY" = false ]; then
  git add -A
fi

if ! git commit -m "WIP: ${MSG}" -n; then
  echo "git-wip: commit failed (nothing to commit?) — no WIP snapshot was saved." >&2
  exit 1
fi
if ! git push; then
  echo "git-wip: push failed — the WIP commit exists locally but was NOT saved to the remote; refs/wip/last is unchanged." >&2
  exit 1
fi
git update-ref refs/wip/last HEAD

