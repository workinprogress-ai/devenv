#!/bin/bash
# git-wip: stage everything and push a WIP snapshot commit.
#
# Hook-bypass exception (intentional): this commit is created with `git
# commit -n`, bypassing pre-commit/commit-msg hooks. WIP snapshots are
# throwaway checkpoints by design — requiring them to pass commitlint would
# defeat their purpose. The exception covers WIP snapshots here and the forced
# version-bump empty commits in repo-bump-version.sh; normal commits must
# always go through hooks.
#

STAGED_ONLY=false
COMMIT_MSG_PARTS=()

for arg in "$@"; do
  case "$arg" in
    --staged-only)
      STAGED_ONLY=true
      ;;
    --*)
      echo "Error: unknown flag '$arg'" >&2
      exit 1
      ;;
    *)
      COMMIT_MSG_PARTS+=("$arg")
      ;;
  esac
done

if [ "$STAGED_ONLY" = false ]; then
  git add -A
fi

git commit -m "WIP: ${COMMIT_MSG_PARTS[*]}" -n
git push
git update-ref refs/wip/last HEAD

